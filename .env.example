# Claude API (Anthropic). Haiku classifies threads and drafts replies.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# Chrome DevTools endpoint created by `npm run chrome`
CHROME_CDP_URL=http://127.0.0.1:9222
CHROME_DEBUG_PORT=9222
CHROME_PATH=
CHROME_USER_DATA=
CHROME_PROFILE=Default

# Policy file — replace or point this at your own .md
POLICY_PATH=skills/conversation-policy.md

# Lookback window if the policy file does not set lookback_minutes
LOOKBACK_MINUTES=30

# Send automatic replies that pass the safety gate
AUTO_SEND=true

# If true, classify and report but never send
DRY_RUN=false
